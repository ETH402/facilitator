# Non-secret Docker Compose inputs. Copy to an operator-owned file outside the
# repository. The application image must be the digest emitted and verified by
# the release workflow; a tag is intentionally rejected by validation.
ETH402_APP_IMAGE=ghcr.io/eth402/facilitator@sha256:REPLACE_WITH_64_HEX_DIGEST
ETH402_APP_ENV_FILE=/opt/eth402/prod/app.env
ETH402_MIGRATION_ENV_FILE=/opt/eth402/prod/migration.env
