# Production configuration template. Copy values into a managed secret/config
# service; do not commit the populated file.
ETH402_ENV=production
ETH402_HTTP_ADDR=:8080
ETH402_PUBLIC_BASE_URL=https://facilitator.example.com

# Runtime PostgreSQL credentials. Production validation requires certificate
# and hostname verification, and the runtime role needs SELECT on
# schema_migrations plus only the DML described in docs/DEPLOYMENT.md.
ETH402_DATABASE_URL=postgres://eth402_runtime@db.example.internal:5432/eth402?sslmode=verify-full
ETH402_DATABASE_MAX_CONNS=10

# Independently operated authenticated providers. Both are contacted directly
# at startup and must report Ethereum chain ID 1.
ETH402_ETHEREUM_RPC_URL=
ETH402_ETHEREUM_FALLBACK_RPC_URL=
ETH402_ETHEREUM_CHAIN_ID=1
ETH402_ETHEREUM_NETWORK=eip155:1
ETH402_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETH402_RPC_TIMEOUT=5s
ETH402_RPC_READ_RETRIES=2
ETH402_REQUIRED_CONFIRMATIONS=12

# Settlement stays disabled until the policy signer, budgets, alerts,
# independent review, and mainnet dry-run approval are complete. To enable it,
# change mode to policy and supply the boundary URL/token; production rejects
# direct KMS and raw-key modes.
ETH402_SIGNER_MODE=disabled
ETH402_POLICY_SIGNER_URL=
ETH402_POLICY_SIGNER_TOKEN=
ETH402_KMS_KEY_NAME=
ETH402_DEV_SIGNER_PRIVATE_KEY=
ETH402_ALLOW_UNSAFE_PRODUCTION_SIGNER=false
ETH402_MAX_FEE_PER_GAS_WEI=0
ETH402_MAX_PRIORITY_FEE_PER_GAS_WEI=0
# Non-zero values below 100000 are rejected (a USDC transferWithAuthorization
# costs well above 21k gas).
ETH402_MAX_GAS_LIMIT=0
ETH402_SETTLEMENT_EXPIRY_MARGIN=60s
ETH402_SIGNING_TIMEOUT=10s
ETH402_SETTLEMENT_LEASE_DURATION=2m
ETH402_SETTLEMENT_RECOVERY_GRACE=2m
ETH402_SETTLEMENT_REPLACEMENT_AFTER=5m
ETH402_WORKER_INTERVAL=15s
ETH402_WORKER_STALE_AFTER=

# Explicit gas-admission budgets. Recalculate before enabling settlement.
ETH402_MERCHANT_SETTLEMENT_QUOTA=1
ETH402_GLOBAL_SETTLEMENT_QUOTA=1
ETH402_MERCHANT_QUOTA_WINDOW=24h

# Provider-neutral SMTP. TLS is mandatory and is probed at startup without
# sending a message. Username/password must be both present or both absent.
ETH402_EMAIL_BACKEND=smtp
ETH402_EMAIL_FILE_DIR=
ETH402_SMTP_ADDRESS=
ETH402_SMTP_USERNAME=
ETH402_SMTP_PASSWORD=
ETH402_SMTP_FROM=
ETH402_SMTP_TLS_MODE=starttls
ETH402_SMTP_TIMEOUT=10s
ETH402_EMAIL_TOKEN_TTL=30m
ETH402_EMAIL_RESEND_INTERVAL=2m
ETH402_EMAIL_OUTBOX_KEY=
ETH402_WALLET_CHALLENGE_TTL=10m
ETH402_MERCHANT_SESSION_TTL=12h
ETH402_RECIPIENT_CHANGE_COOLDOWN=24h

# Generate independent values in the managed secret store. The email outbox key
# above is exactly 32 random bytes encoded as 64 hexadecimal characters.
ETH402_API_KEY_PEPPER=
ETH402_OPERATOR_TOKEN=
ETH402_TERMS_VERSION=2026-07-27

ETH402_DISPOSABLE_EMAIL_BLOCK=true
ETH402_FREE_EMAIL_RESTRICTION=false
ETH402_EMAIL_DOMAIN_ALLOWLIST=
ETH402_EMAIL_DOMAIN_DENYLIST=
ETH402_REGISTRATION_RATE_PER_MINUTE=5
ETH402_PUBLIC_RATE_PER_MINUTE=60
ETH402_MERCHANT_REQUESTS_PER_WINDOW=5000
ETH402_FAIR_USE_WINDOW=1h

# Primary-database lifecycle. Backups need a separately enforced lifecycle.
ETH402_PAYMENT_RETENTION=720h
ETH402_EPHEMERAL_RETENTION=24h
ETH402_REVOKED_KEY_RETENTION=720h
ETH402_RETENTION_INTERVAL=1h
ETH402_RETENTION_BATCH_SIZE=500

# Set to every proxy hop that may append X-Forwarded-For.
ETH402_TRUSTED_PROXIES=
ETH402_STATS_CACHE_TTL=10s
ETH402_PUBLISH_STATS_VOLUME=false
ETH402_LOG_LEVEL=info
ETH402_METRICS_ENABLED=true
