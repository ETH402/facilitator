# Configuration for cmd/policysigner, the settlement signing boundary.
#
# This runs as a SEPARATE workload with a SEPARATE service identity from the
# facilitator, and it must be the only identity granted use of the Cloud KMS key
# version. Leaving that grant on the facilitator as well makes the boundary
# decorative: the facilitator would simply bypass it. See docs/KEY_MANAGEMENT.md.

POLICYSIGNER_LISTEN_ADDRESS=127.0.0.1:8081

# Must match ETH402_POLICY_SIGNER_TOKEN and be at least 32 characters. It is the
# only thing separating this from an open signing service.
POLICYSIGNER_TOKEN=

# The Cloud KMS secp256k1 key VERSION, not the key:
# projects/…/locations/…/keyRings/…/cryptoKeys/…/cryptoKeyVersions/N
POLICYSIGNER_KMS_KEY_NAME=

# Spend ceilings. These belong to the boundary, never to a request: a compromised
# caller that cannot change what is signed would otherwise raise what it can burn.
# Unset means sign nothing, not sign anything — the boundary refuses to start.
# Set them at or above the facilitator's own ETH402_MAX_* values, or legitimate
# settlements will be refused here after passing the facilitator's checks.
POLICYSIGNER_MAX_FEE_PER_GAS_WEI=
POLICYSIGNER_MAX_PRIORITY_FEE_PER_GAS_WEI=
POLICYSIGNER_MAX_GAS_LIMIT=
