{
	# Caddy must know which peers may assert a client address so that its own
	# client_ip and the X-Forwarded-For chain stay trustworthy.
	servers {
		trusted_proxies static private_ranges
		# The application caps headers at 32 KiB too; rejecting here means an
		# oversized request never reaches it.
		max_header_size 32KB
	}
}

:80 {
	encode zstd gzip

	# Prometheus scrapes app:8080 directly on the container network, so metrics are
	# never served on the public interface. The wildcard matters: /metrics/ and any
	# subpath must be refused too, or the block is trivially sidestepped.
	handle /metrics* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		respond "not found" 404
	}

	request_body {
		max_size 1MB
	}

	# Replace rather than append: the application trusts this proxy, so the chain
	# must contain only the address Caddy actually observed. Operators who add a CDN
	# in front must instead append and extend ETH402_TRUSTED_PROXIES to cover every
	# intermediate hop.
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {http.request.remote.host}
		# CSP is applied below with path-aware proxy rules. Remove the upstream
		# copy so clients receive one unambiguous policy rather than two identical
		# fields whose intersection happens to be equivalent.
		header_down -Content-Security-Policy

		# Bound every stage, so a wedged upstream cannot pin Caddy's workers open.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 60s
		}
	}

	# Human-facing pages get narrowly scoped policies: status and email verification
	# retain inline CSS, while product pages load only first-party assets. Only the
	# email and merchant flows permit forms; only the merchant panel runs script.
	# Mutually exclusive path matchers avoid intersecting a page policy with the
	# API default and accidentally blocking a required asset.
	header /status Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
	header /verify-email Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'self'"
	header / Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header /explore Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header /assets/* Content-Security-Policy "default-src 'none'"
	header /merchant* Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	@default_csp not path / /status /verify-email /explore /assets/* /merchant*
	header @default_csp Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

	# Set on every response, including Caddy's own 404 above, which never reaches
	# the application's own header middleware.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Public deployment: replace the :80 block above with the domain so Caddy obtains
# and renews TLS automatically, and keep everything else identical.
#
#	facilitator.example.org {
#		...same body...
#	}
#
# Behind a managed TLS load balancer instead, keep :80 and add that balancer's
# egress range to ETH402_TRUSTED_PROXIES, or client addresses collapse to one
# rate-limit bucket.
