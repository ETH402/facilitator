{
	# Caddy must know which peers may assert a client address so that its own
	# client_ip and the X-Forwarded-For chain stay trustworthy.
	servers {
		trusted_proxies static private_ranges
		# The application caps headers at 32 KiB too; rejecting here means an
		# oversized request never reaches it.
		max_header_size 32KB
	}
}

:80 {
	encode zstd gzip

	# Prometheus scrapes app:8080 directly on the container network, so metrics are
	# never served on the public interface. The wildcard matters: /metrics/ and any
	# subpath must be refused too, or the block is trivially sidestepped.
	handle /metrics* {
		respond "not found" 404
	}

	request_body {
		max_size 1MB
	}

	# Replace rather than append: the application trusts this proxy, so the chain
	# must contain only the address Caddy actually observed. Operators who add a CDN
	# in front must instead append and extend ETH402_TRUSTED_PROXIES to cover every
	# intermediate hop.
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {http.request.remote.host}

		# Bound every stage, so a wedged upstream cannot pin Caddy's workers open.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 60s
		}
	}

	# Set on every response, including Caddy's own 404 above, which never reaches
	# the application's own header middleware.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		# Preserve stricter or page-specific policies from the application (for
		# example, the self-contained status page and email confirmation form),
		# while still protecting responses generated by Caddy itself.
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Public deployment: replace the :80 block above with the domain so Caddy obtains
# and renews TLS automatically, and keep everything else identical.
#
#	facilitator.example.org {
#		...same body...
#	}
#
# Behind a managed TLS load balancer instead, keep :80 and add that balancer's
# egress range to ETH402_TRUSTED_PROXIES, or client addresses collapse to one
# rate-limit bucket.
