#!/bin/sh

set -eu

GO_CMD=${GO:-go}

if [ -z "${ETH402_TEST_DATABASE_URL:-}" ]; then
	echo "ETH402_TEST_DATABASE_URL is required; incident simulations use the destructive integration-test database" >&2
	exit 2
fi

case "$ETH402_TEST_DATABASE_URL" in
	*"/eth402_test" | *"/eth402_test?"*)
		;;
	*)
		echo "refusing to run: ETH402_TEST_DATABASE_URL must name the eth402_test database" >&2
		exit 2
		;;
esac

run_drill() {
	name=$1
	shift
	printf '\n== %s ==\n' "$name"
	"$@"
}

run_drill "RPC outage detection and fallback accounting" \
	"$GO_CMD" test -race -count=1 -v ./internal/ethereum \
	-run '^TestObserverCountsRealRequestsAndRetries$'

run_drill "Readiness and public-status degradation" \
	"$GO_CMD" test -race -count=1 -v ./internal/httpapi ./internal/stats \
	-run '^(TestReadinessFailure|TestWrongRPCChainNotReady|TestStatusReflectsRealObservations|TestOutageOutranksDegraded|TestUnobservableStatusIsNotOperational)$'

run_drill "Signer outage and stale-balance detection" \
	"$GO_CMD" test -race -count=1 -v ./internal/settlement ./internal/metrics \
	-run '^(TestBroadcastSigningErrorKeepsIntent|TestBalanceWorkerFailedReadPreservesLastValue|TestSignerBalanceExposedWithFreshness)$'

run_drill "Ambiguous broadcast, reorg, and exact recovery" \
	"$GO_CMD" test -race -count=1 -v ./internal/settlement \
	-run '^(TestBroadcastSendErrorMarksAmbiguous|TestResolveAmbiguousReceiptFound|TestResolveAmbiguousRebroadcastNondeterministic|TestResolveAmbiguousSighashMismatchRefuses|TestConfirmationRejectsNonCanonicalReceipt|TestConfirmationReorgReturnsToBroadcast)$'

run_drill "Worker crash containment and lease ownership" \
	"$GO_CMD" test -race -count=1 -v ./internal/settlement \
	-run '^(TestWorkerPanicDoesNotEscapeOrStrandLease|TestWorkerTickGuardsClaimPanic|TestWorkerSkipsPaymentWhenBatchLeaseWasLost)$'

run_drill "Durable recovery and nonce-gap reconciliation" \
	"$GO_CMD" test -tags=integration -race -p 1 -count=1 -v ./internal/store \
	-run '^(TestRecoveredBroadcastReturnsToPipeline|TestReorgedOutReturnsToBroadcast|TestDroppedBlockingGapLifecycle|TestSimulationFailedGapWaitsUntilAuthorizationExpiry|TestConcurrentRecoveryWorkersDoNotBothActOnAPayment)$'

printf '\nAll incident simulations passed.\n'
