#!/bin/sh
# ssh-keygen wrapper for git commit signing.
#
# Git signs by invoking ssh-keygen, which consults SSH_AUTH_SOCK. On a machine
# running an SSH agent that owns its own keys — 1Password's, for instance — the
# agent intercepts the request and refuses, because the agent-signing key is a
# plain file it has never heard of. Clearing SSH_AUTH_SOCK makes ssh-keygen use
# the key file directly, which is what per-agent attribution needs.
unset SSH_AUTH_SOCK
exec ssh-keygen "$@"
