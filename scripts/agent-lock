#!/bin/sh
# Serialises access to the shared working tree between agents.
#
# Three agents share one checkout, so two of them editing at once produces
# exactly what it sounds like: a commit containing someone else's diff, or a
# `git add -A` that captures a half-finished edit. This lock makes "one agent at
# a time" enforceable rather than hoped for.
#
# Acquisition is atomic because mkdir(2) either creates the directory or fails —
# there is no window between checking and taking, which a lock file written with
# `>` would have.
#
#   scripts/agent-lock acquire <agent> "<task>"
#   scripts/agent-lock release <agent>
#   scripts/agent-lock status
#   scripts/agent-lock steal <agent> "<reason>"     # only when stale
#
# The lock lives outside git (see .gitignore): it is live state, not history.
set -eu

LOCK_DIR=".agent-lock"
META="$LOCK_DIR/holder"
STALE_MINUTES="${AGENT_LOCK_STALE_MINUTES:-45}"

usage() {
	sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
	exit 2
}

now_epoch() { date +%s; }

# meta_get reads one field. The metadata is parsed rather than sourced: a task
# description contains spaces, and sourcing it would both break on that and
# execute whatever the file happens to contain.
meta_get() {
	[ -f "$META" ] || return 1
	sed -n "s/^$1=//p" "$META" | head -1
}

age_minutes() {
	since="$(meta_get HELD_SINCE 2>/dev/null || true)"
	case "$since" in
	'' | *[!0-9]*) echo 0 ;;
	*) echo $(( ( $(now_epoch) - since ) / 60 )) ;;
	esac
}

show_holder() {
	holder="$(meta_get AGENT 2>/dev/null || true)"
	if [ -z "$holder" ]; then
		echo "lock directory exists but has no holder metadata; treat as stale"
		return
	fi
	printf 'held by %s for %s minute(s)\n  task: %s\n' "$holder" "$(age_minutes)" "$(meta_get TASK)"
}

cmd_acquire() {
	agent="${1:?agent name required}"
	task="${2:?task description required}"
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		printf 'AGENT=%s\nTASK=%s\nHELD_SINCE=%s\n' "$agent" "$task" "$(now_epoch)" > "$META"
		echo "lock acquired by $agent"
		echo "release it with: scripts/agent-lock release $agent"
		return 0
	fi
	echo "cannot acquire: $(show_holder)" >&2
	if [ "$(age_minutes)" -ge "$STALE_MINUTES" ]; then
		echo >&2
		echo "the lock is stale (>= ${STALE_MINUTES}m). If that agent is gone:" >&2
		echo "  scripts/agent-lock steal $agent \"why\"" >&2
	fi
	return 1
}

cmd_release() {
	agent="${1:?agent name required}"
	[ -d "$LOCK_DIR" ] || { echo "no lock held"; return 0; }
	holder="$(meta_get AGENT 2>/dev/null || true)"
	if [ -n "$holder" ] && [ "$holder" != "$agent" ]; then
		# Releasing someone else's lock is how two agents end up editing at once.
		echo "refusing: lock is held by $holder, not $agent" >&2
		echo "if that agent is gone, use steal (it records who took it and why)" >&2
		return 1
	fi
	rm -rf "$LOCK_DIR"
	echo "lock released by $agent"
}

cmd_status() {
	if [ ! -d "$LOCK_DIR" ]; then
		echo "unlocked"
		return 0
	fi
	show_holder
	if [ "$(age_minutes)" -ge "$STALE_MINUTES" ]; then
		echo "STALE: held >= ${STALE_MINUTES}m"
	fi
	# A dirty tree under someone else's lock is the state that loses work.
	if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
		echo "working tree is dirty; do not stage with 'git add -A'"
	fi
}

cmd_steal() {
	agent="${1:?agent name required}"
	reason="${2:?reason required}"
	[ -d "$LOCK_DIR" ] || { echo "no lock to steal"; return 1; }
	minutes="$(age_minutes)"
	if [ "$minutes" -lt "$STALE_MINUTES" ] && [ "${AGENT_LOCK_FORCE:-0}" != "1" ]; then
		echo "refusing: lock is only ${minutes}m old (stale at ${STALE_MINUTES}m)" >&2
		echo "the holder may be mid-edit. Override with AGENT_LOCK_FORCE=1 only if you know it is gone." >&2
		return 1
	fi
	previous="$(meta_get AGENT 2>/dev/null || true)"
	[ -n "$previous" ] || previous="unknown"
	rm -rf "$LOCK_DIR"
	mkdir "$LOCK_DIR"
	printf 'AGENT=%s\nTASK=%s\nHELD_SINCE=%s\n' "$agent" "stolen from $previous: $reason" "$(now_epoch)" > "$META"
	echo "lock stolen from $previous by $agent"
	echo "the previous holder may have uncommitted work; check 'git status' before editing"
}

[ $# -ge 1 ] || usage
command="$1"
shift
case "$command" in
acquire) cmd_acquire "$@" ;;
release) cmd_release "$@" ;;
status) cmd_status "$@" ;;
steal) cmd_steal "$@" ;;
*) usage ;;
esac
